{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/implementation.schema.json",
  "title": "FitFlow Implementation",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "schema_version", "task_id", "run_id", "created_at", "baseline_revision", "working_tree_fingerprint", "author_role", "role", "effective_model_id", "reasoning_level", "status", "files", "acceptance_criteria", "self_checks", "deviations", "context_required"],
  "properties": {
    "artifact": {"const": "IMPLEMENTATION"},
    "schema_version": {"const": "fitflow-implementation/v1"},
    "task_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string", "format": "date-time"},
    "baseline_revision": {"type": "string", "minLength": 1},
    "working_tree_fingerprint": {"type": "string", "pattern": "^sha256:.+$"},
    "author_role": {"enum": ["coder_a", "coder_b"]},
    "role": {"enum": ["coder_a", "coder_b"]},
    "effective_model_id": {"type": "string", "minLength": 1},
    "reasoning_level": {"enum": ["low", "medium"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NEEDS_CONTEXT", "NEEDS_CODER_A"]},
    "files": {"type": "array", "items": {"type": "object", "required": ["path", "operation", "responsibility"], "properties": {"path": {"type": "string"}, "operation": {"enum": ["add", "modify", "delete"]}, "responsibility": {"type": "string"}}, "additionalProperties": false}},
    "acceptance_criteria": {"type": "array", "items": {"type": "object", "required": ["id", "status", "evidence"], "properties": {"id": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]}, "evidence": {"type": "string"}}, "additionalProperties": false}},
    "self_checks": {"type": "array", "items": {"type": "object", "required": ["check", "status"], "properties": {"check": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNAVAILABLE"]}, "note": {"type": "string"}}, "additionalProperties": false}},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "context_required": {"type": ["string", "null"]}
  }
}
