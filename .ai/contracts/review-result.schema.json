{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/v2/review-result.schema.json",
  "title": "ReviewResult v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "schema_version", "task_id", "run_id", "created_at", "baseline", "reviewer_role", "independent", "verdict", "findings", "validation_ref", "next_state"],
  "properties": {
    "artifact": {"const": "REVIEW_RESULT"},
    "schema_version": {"const": "fitflow-review-result/v2"},
    "task_id": {"$ref": "common.schema.json#/$defs/taskId"},
    "run_id": {"$ref": "common.schema.json#/$defs/runId"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "baseline": {"$ref": "common.schema.json#/$defs/baseline"},
    "reviewer_role": {"enum": ["reviewer", "architect", "developer"]},
    "independent": {"type": "boolean"},
    "verdict": {"enum": ["PASS", "FAIL", "REPLAN", "BLOCKED"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "body"],
        "properties": {
          "severity": {"enum": ["critical", "high", "medium", "low", "note"]},
          "title": {"type": "string", "minLength": 1},
          "body": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "validation_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "summary": {"type": "string"},
    "next_state": {"enum": ["DOC_SYNC", "ROUTING", "EXPLORING", "PLANNING", "WAITING_DEVELOPER", "BLOCKED"]}
  }
}
