{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/index-run.schema.json",
  "title": "FitFlow Index Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "schema_version", "task_id", "run_id", "created_at", "author_role", "scope", "mode", "baseline_revision", "working_tree_fingerprint", "versions", "inputs", "outputs", "counts", "checks", "status", "promotion"],
  "properties": {
    "artifact": {"const": "INDEX_RUN"},
    "schema_version": {"const": "fitflow-index-run/v1"},
    "task_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string", "format": "date-time"},
    "author_role": {"const": "indexer"},
    "scope": {"enum": ["backend", "frontend", "mixed", "docs_tooling"]},
    "mode": {"enum": ["full", "incremental", "verify", "promote"]},
    "baseline_revision": {"type": "string", "minLength": 1},
    "working_tree_fingerprint": {"type": "string", "pattern": "^sha256:.+$"},
    "versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["path", "hash"], "properties": {"path": {"type": "string"}, "hash": {"type": "string"}}, "additionalProperties": false}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["path_or_collection", "hash_or_version"], "properties": {"path_or_collection": {"type": "string"}, "hash_or_version": {"type": "string"}}, "additionalProperties": false}},
    "counts": {"type": "object", "required": ["discovered", "parsed", "unparsed", "inserted", "updated", "deleted", "errors"], "properties": {"discovered": {"type": "integer", "minimum": 0}, "parsed": {"type": "integer", "minimum": 0}, "unparsed": {"type": "integer", "minimum": 0}, "inserted": {"type": "integer", "minimum": 0}, "updated": {"type": "integer", "minimum": 0}, "deleted": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "status", "evidence"], "properties": {"id": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "UNAVAILABLE"]}, "evidence": {"type": "string"}}, "additionalProperties": false}},
    "status": {"enum": ["PASS", "FAIL", "UNAVAILABLE", "BLOCKED"]},
    "promotion": {"enum": ["working_only", "pending_human_acceptance", "promoted"]}
  }
}
