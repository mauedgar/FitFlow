{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/result.schema.json",
  "title": "FitFlow Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "schema_version", "task_id", "run_id", "created_at", "baseline_revision", "working_tree_fingerprint", "author_role", "status", "summary", "files", "review_status", "validation_status", "acceptance_criteria", "risks", "follow_ups", "document_impact", "human_actions"],
  "properties": {
    "artifact": {"const": "RESULT"},
    "schema_version": {"const": "fitflow-result/v1"},
    "task_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string", "format": "date-time"},
    "baseline_revision": {"type": "string", "minLength": 1},
    "working_tree_fingerprint": {"type": "string", "pattern": "^sha256:.+$"},
    "author_role": {"const": "orchestrator"},
    "status": {"enum": ["PENDING_ACCEPTANCE", "BLOCKED", "FAILED", "CANCELLED"]},
    "summary": {"type": "string", "minLength": 5},
    "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "operation", "summary"], "properties": {"path": {"type": "string"}, "operation": {"enum": ["add", "modify", "delete"]}, "summary": {"type": "string"}}}},
    "review_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]},
    "validation_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNAVAILABLE", "BLOCKED", "N/A"]},
    "acceptance_criteria": {"type": "array", "items": {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]}}, "additionalProperties": false}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "follow_ups": {"type": "array", "items": {"type": "string"}},
    "document_impact": {"type": "array", "items": {"type": "string"}},
    "human_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
