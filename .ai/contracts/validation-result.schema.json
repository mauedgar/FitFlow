{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/v2/validation-result.schema.json",
  "title": "ValidationResult v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "schema_version", "task_id", "run_id", "created_at", "baseline", "status", "gates", "next_state"],
  "properties": {
    "artifact": {"const": "VALIDATION_RESULT"},
    "schema_version": {"const": "fitflow-validation-result/v2"},
    "task_id": {"$ref": "common.schema.json#/$defs/taskId"},
    "run_id": {"$ref": "common.schema.json#/$defs/runId"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "baseline": {"$ref": "common.schema.json#/$defs/baseline"},
    "status": {"$ref": "common.schema.json#/$defs/normalizedStatus"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "command", "cwd", "status", "exit_code", "summary"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "cwd": {"type": "string", "minLength": 1},
          "status": {"$ref": "common.schema.json#/$defs/normalizedStatus"},
          "exit_code": {"type": ["integer", "null"]},
          "duration_ms": {"type": ["integer", "null"], "minimum": 0},
          "summary": {"type": "string", "minLength": 1},
          "output_artifact": {"anyOf": [{"$ref": "common.schema.json#/$defs/artifactRef"}, {"type": "null"}]}
        }
      }
    },
    "next_state": {"enum": ["REVIEWING", "ROUTING", "EXPLORING", "PLANNING", "BLOCKED", "BLOCKED_HIGH_RISK"]}
  }
}
