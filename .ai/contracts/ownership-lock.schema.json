{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/ownership-lock.schema.json",
  "title": "FitFlow Ownership Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lock_id", "task_id", "run_id", "keys", "mode", "acquired_at", "expires_at", "status"],
  "properties": {
    "schema_version": {"const": "fitflow-ownership-lock/v1"},
    "lock_id": {"type": "string", "minLength": 3},
    "task_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(path|api|domain|db|doc|config):.+$"}},
    "mode": {"enum": ["read", "write"]},
    "acquired_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ACTIVE", "RELEASED", "EXPIRED", "BLOCKED"]}
  }
}
