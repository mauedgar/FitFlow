{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/context-package.schema.json",
  "title": "FitFlow Context Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "task_id", "run_id", "author_role", "scope", "query", "freshness", "baseline_revision", "working_tree_fingerprint", "generated_at", "token_budget", "estimated_tokens", "evidence", "relations", "gaps"],
  "properties": {
    "schema_version": {"const": "fitflow-context-package/v1"},
    "package_id": {"type": "string", "minLength": 3},
    "task_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "author_role": {"const": "explorer"},
    "scope": {"enum": ["backend", "frontend", "mixed", "docs_tooling"]},
    "query": {"type": "string", "minLength": 5},
    "freshness": {"enum": ["FRESH", "PARTIAL", "STALE", "INVALID"]},
    "baseline_revision": {"type": "string", "minLength": 1},
    "working_tree_fingerprint": {"type": "string", "pattern": "^sha256:.+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "token_budget": {"type": "integer", "minimum": 1},
    "estimated_tokens": {"type": "integer", "minimum": 0},
    "budget_override_reason": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "path", "start_line", "end_line", "content_hash", "reason", "source"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "symbol": {"type": ["string", "null"]},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:.+$"},
          "reason": {"type": "string", "minLength": 3},
          "source": {"enum": ["direct", "repo-packager", "xml_graph", "repomix", "vector", "text"]}
        }
      }
    },
    "relations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "target_id", "kind"], "properties": {"source_id": {"type": "string"}, "target_id": {"type": "string"}, "kind": {"type": "string"}, "confidence": {"enum": ["low", "medium", "high"]}}}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "sources_manifest_hash": {"type": ["string", "null"], "pattern": "^sha256:.+$"}
  }
}
