{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/context-request.schema.json",
  "title": "FitFlow Context Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "schema_version", "task_id", "run_id", "status", "created_at", "author_role", "scope", "baseline_revision", "working_tree_fingerprint", "query", "evidence_types", "token_budget", "round", "sufficiency_condition"],
  "properties": {
    "artifact": {"const": "CONTEXT_REQUEST"},
    "schema_version": {"const": "fitflow-context-request/v1"},
    "task_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "status": {"enum": ["READY", "BLOCKED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "author_role": {"enum": ["planner_audit", "coder_a", "reviewer"]},
    "scope": {"enum": ["backend", "frontend", "mixed", "docs_tooling"]},
    "baseline_revision": {"type": "string", "minLength": 1},
    "working_tree_fingerprint": {"type": "string", "pattern": "^sha256:.+$"},
    "query": {"type": "string", "minLength": 5},
    "evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["definitions", "callers", "callees", "tests", "contracts", "config", "docs", "relations"]}},
    "known_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "additional_exclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "token_budget": {"type": "integer", "minimum": 1, "maximum": 12000},
    "round": {"type": "integer", "minimum": 1, "maximum": 2},
    "sufficiency_condition": {"type": "string", "minLength": 5}
  }
}
