{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitflow.local/schemas/task.schema.json",
  "title": "FitFlow Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "schema_version", "task_id", "title", "status", "task_type", "scope", "risk", "created_at", "baseline_revision", "working_tree_fingerprint", "author_role", "run_id", "objective", "in_scope", "out_of_scope", "acceptance_criteria", "ownership_keys"],
  "properties": {
    "artifact": {"const": "TASK"},
    "schema_version": {"const": "fitflow-task/v1"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,31}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "status": {"enum": ["BACKLOG", "READY", "PLAN", "EXPLORE", "EXECUTE", "REVIEW", "VALIDATE", "PENDING_ACCEPTANCE", "DONE", "BLOCKED", "BLOCKED_HIGH_RISK", "CANCELLED"]},
    "task_type": {"enum": ["use_case", "feature", "fix", "refactor", "audit", "test", "docs", "tooling"]},
    "area": {"enum": ["backend", "frontend", "infra", "docs", "ai_tooling", "mixed"]},
    "scope": {"enum": ["backend", "frontend", "mixed", "docs_tooling"]},
    "lane": {"enum": ["human", "ai_orchestrated", "mixed", "undecided"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "created_at": {"type": "string", "format": "date-time"},
    "author_role": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 10, "maxLength": 1000},
    "in_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "criterion"], "properties": {"id": {"type": "string", "pattern": "^AC-[0-9]+$"}, "criterion": {"type": "string", "minLength": 5}, "evidence": {"type": ["string", "null"]}}}},
    "ownership_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(path|api|domain|db|doc|config):.+$"}},
    "required_docs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "validation_expected": {"type": "array", "items": {"type": "string"}},
    "document_impact": {"type": "array", "items": {"type": "string"}},
    "baseline_revision": {"type": "string", "minLength": 1},
    "working_tree_fingerprint": {"type": "string", "pattern": "^sha256:.+$"},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,31}$"}}
  }
}
