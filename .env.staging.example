# Non-secret staging contract. Inject secret values at runtime; do not commit them.
ENV=staging
DEBUG=false
LOG_LEVEL=INFO
POSTGRES_DB=fitflow_staging
POSTGRES_USER=fitflow_staging
POSTGRES_PASSWORD=
SECRET_KEY=
BACKEND_CORS_ORIGINS=["https://staging.example.invalid"]
STAGING_BACKEND_PORT=18000
STAGING_FRONTEND_PORT=18080
# Reserved isolated Compose edge network. Check host conflicts before deploying.
FITFLOW_EDGE_SUBNET=172.30.251.0/24
FITFLOW_TRUSTED_PROXY_IP=172.30.251.10
# Breaking change permitted only in isolated staging; production uses compatible until approved.
FITFLOW_REFRESH_ACK_POLICY=required
VITE_API_BASE_URL=/api/v1
# Single Product authority: frontend image build receives this exact backend value.
FITFLOW_TIMEZONE=America/Argentina/Buenos_Aires
