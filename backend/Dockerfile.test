FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv

FROM python:3.15.2-slim-bookworm@sha256:4e03260adeeebafccd084f3584e6b84823aba5651cfb53ef8a078ed441ddf9cd

COPY --from=uv /uv /uvx /usr/local/bin/

# The backend test image needs only the digest-pinned Python/uv runtime.
# No active consumer invokes global Node/npm/AJV in this disposable image.

WORKDIR /app

COPY backend/requirements_backend.txt backend/requirements_test.txt ./backend/
RUN uv pip install --system --no-cache-dir --upgrade -r backend/requirements_test.txt

COPY backend/__init__.py ./backend/
COPY backend/app ./backend/app
COPY backend/alembic/env.py backend/alembic/README backend/alembic/script.py.mako ./backend/alembic/
COPY backend/alembic/versions ./backend/alembic/versions
COPY backend/alembic.ini backend/pytest.ini ./backend/
COPY backend/tests ./backend/tests

WORKDIR /app/backend

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/backend

CMD ["sleep", "infinity"]
