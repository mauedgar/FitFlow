FROM ghcr.io/astral-sh/uv:latest AS uv

FROM python:3.11-slim

COPY --from=uv /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get install --no-install-recommends -y libatomic1 ca-certificates nodejs npm \
    && npm install -g ajv-cli ajv-formats \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements_backend.txt backend/requirements_test.txt ./backend/
RUN uv pip install --system --no-cache-dir --upgrade -r backend/requirements_test.txt

COPY backend/ ./backend/

WORKDIR /app/backend

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/backend

CMD ["sleep", "infinity"]
